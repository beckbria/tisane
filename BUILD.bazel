load("@gazelle//:def.bzl", "gazelle")
load("@rules_go//go:def.bzl", "go_library", "go_test")
load(":release.bzl", "release_archive", "windows_installer")

# gazelle:ignore
# gazelle:prefix tisane
# gazelle:build_file_name BUILD.bazel
gazelle(name = "gazelle")

exports_files(["VERSION"])

go_library(
    name = "version",
    srcs = ["version.go"],
    embedsrcs = ["VERSION"],
    importpath = "tisane",
    visibility = ["//visibility:public"],
)

go_test(
    name = "version_test",
    srcs = ["version_test.go"],
    data = ["VERSION"],
    embed = [":version"],
)

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "windows_amd64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

alias(
    name = "tisane",
    actual = "//cmd/tisane:tisane",
    visibility = ["//visibility:public"],
)

alias(
    name = "tisane-cli",
    actual = "//cmd/tisane-cli:tisane-cli",
    visibility = ["//visibility:public"],
)

alias(
    name = "tisane-build",
    actual = "//cmd/tisane-build:tisane-build",
    visibility = ["//visibility:public"],
)

alias(
    name = "tisane-extract",
    actual = "//cmd/tisane-extract:tisane-extract",
    visibility = ["//visibility:public"],
)

alias(
    name = "tisane-merge",
    actual = "//cmd/tisane-merge:tisane-merge",
    visibility = ["//visibility:public"],
)

alias(
    name = "tisane-windows",
    actual = "//cmd/tisane:tisane-windows",
    visibility = ["//visibility:public"],
)

alias(
    name = "tisane-cli-windows",
    actual = "//cmd/tisane-cli:tisane-cli-windows",
    visibility = ["//visibility:public"],
)

alias(
    name = "tisane-build-windows",
    actual = "//cmd/tisane-build:tisane-build-windows",
    visibility = ["//visibility:public"],
)

alias(
    name = "tisane-extract-windows",
    actual = "//cmd/tisane-extract:tisane-extract-windows",
    visibility = ["//visibility:public"],
)

alias(
    name = "tisane-merge-windows",
    actual = "//cmd/tisane-merge:tisane-merge-windows",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "dictionaries",
    srcs = glob(
        ["dictionaries/**"],
        exclude = [
            "**/.*",
            "dictionaries/private/**",
        ],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "private_dictionaries",
    srcs = glob(
        ["dictionaries/private/**"],
        exclude = [
            "**/.*",
            "**/README.md",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "linux",
    srcs = select({
        "@platforms//os:linux": [
            ":tisane",
            ":tisane-build",
            ":tisane-cli",
            ":tisane-extract",
            ":tisane-merge",
        ],
        "//conditions:default": [
            "//cmd/tisane:tisane_linux_bin",
            "//cmd/tisane-build:tisane-build_linux_bin",
            "//cmd/tisane-cli:tisane-cli_linux_bin",
            "//cmd/tisane-extract:tisane-extract_linux_bin",
            "//cmd/tisane-merge:tisane-merge_linux_bin",
        ],
    }),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "windows",
    srcs = [
        ":tisane-build-windows",
        ":tisane-cli-windows",
        ":tisane-extract-windows",
        ":tisane-merge-windows",
        ":tisane-windows",
    ],
    visibility = ["//visibility:public"],
)

release_archive(
    name = "linux-release",
    out = "linux-release.tar.gz",
    binaries = [":linux"],
    dictionaries = [":dictionaries"],
    extra_files = {
        "//build:appicon.png": "tisane.png",
        "//build:linux/tisane.desktop": "tisane.desktop",
    },
    format = "tar.gz",
    private_dictionaries = [":private_dictionaries"],
    visibility = ["//visibility:public"],
)

windows_installer(
    name = "windows-release",
    out = "tisane-setup.exe",
    binaries = [":windows"],
    dictionaries = [":dictionaries"],
    icon = "//build:appicon.png",
    private_dictionaries = [":private_dictionaries"],
    script = "//build:windows/installer.nsi",
    visibility = ["//visibility:public"],
)

release_archive(
    name = "windows-release-zip",
    out = "windows-release.zip",
    binaries = [":windows"],
    dictionaries = [":dictionaries"],
    format = "zip",
    private_dictionaries = [":private_dictionaries"],
    visibility = ["//visibility:public"],
)
