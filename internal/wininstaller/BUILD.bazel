load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "wininstaller_lib",
    srcs = ["main.go"],
    importpath = "tisane/internal/wininstaller",
    visibility = ["//visibility:private"],
    deps = [
        "//:version",
        "@com_github_tc_hib_winres//:winres",
    ],
)

go_binary(
    name = "wininstaller",
    embed = [":wininstaller_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "wininstaller_test",
    srcs = ["main_test.go"],
    embed = [":wininstaller_lib"],
)
