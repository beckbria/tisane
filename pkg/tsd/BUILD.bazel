load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "tsd",
    srcs = [
        "builder.go",
        "definitions.go",
        "encoding.go",
        "export.go",
        "huffman.go",
        "stream.go",
        "tsd.go",
