load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "tisane-build_lib",
    srcs = ["main.go"],
    importpath = "tisane/cmd/tisane-build",
    visibility = ["//visibility:private"],
    deps = ["//pkg/tsd"],
)

go_binary(
    name = "tisane-build",
    embed = [":tisane-build_lib"],
    visibility = ["//visibility:public"],
)

go_binary(
    name = "tisane-build_linux_bin",
    out = "tisane-build",
    embed = [":tisane-build_lib"],
    goarch = "amd64",
    goos = "linux",
    pure = "on",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

go_binary(
    name = "tisane-build_windows_bin",
    embed = [":tisane-build_lib"],
    goarch = "amd64",
    goos = "windows",
    pure = "on",
    tags = ["manual"],
    visibility = ["//visibility:private"],
)

genrule(
    name = "tisane-build-windows",
    srcs = [":tisane-build_windows_bin"],
    outs = ["tisane-build.exe"],
    cmd = "cp $< $@",
    cmd_ps = "Copy-Item -LiteralPath '$<' -Destination '$@' -Force",
    executable = True,
    visibility = ["//visibility:public"],
)

go_test(
    name = "tisane-build_test",
    srcs = ["main_test.go"],
    embed = [":tisane-build_lib"],
)
