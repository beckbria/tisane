load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "tisane-extract_lib",
    srcs = ["main.go"],
    importpath = "tisane/cmd/tisane-extract",
    visibility = ["//visibility:private"],
    deps = ["//pkg/tsd"],
)

go_binary(
    name = "tisane-extract",
    embed = [":tisane-extract_lib"],
    visibility = ["//visibility:public"],
)

go_binary(
    name = "tisane-extract_windows_bin",
    embed = [":tisane-extract_lib"],
    goarch = "amd64",
    goos = "windows",
    pure = "on",
    tags = ["manual"],
    visibility = ["//visibility:private"],
)

genrule(
    name = "tisane-extract-windows",
    srcs = [":tisane-extract_windows_bin"],
    outs = ["tisane-extract.exe"],
    cmd = "cp $< $@",
    executable = True,
    visibility = ["//visibility:public"],
)

go_test(
    name = "tisane-extract_test",
    srcs = ["main_test.go"],
    embed = [":tisane-extract_lib"],
    deps = ["//pkg/tsd"],
)
