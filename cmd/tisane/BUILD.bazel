load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load(":frontend.bzl", "frontend_dist")
load(":winrsrc.bzl", "windows_syso")

_PREBUILT_DIST = glob(
    ["frontend/dist/**"],
    allow_empty = True,
)

frontend_dist(
    name = "frontend_dist",
    srcs = glob([
        "frontend/index.html",
        "frontend/package.json",
        "frontend/package-lock.json",
        "frontend/svelte.config.js",
        "frontend/tsconfig.json",
        "frontend/vite.config.ts",
        "frontend/public/**",
        "frontend/src/**",
    ]),
    tags = ["manual"],
)

windows_syso(
    name = "tisane_rsrc_windows_amd64",
    arch = "amd64",
    icon = "icon.png",
    out = "rsrc_windows_amd64.syso",
)

go_library(
    name = "tisane_lib",
    srcs = ["main.go"] + select({
        "@rules_go//go/platform:windows_amd64": [":tisane_rsrc_windows_amd64"],
        "//conditions:default": [],
    }),  # keep
    embedsrcs = [
        "icon.png",
    ] + (_PREBUILT_DIST if _PREBUILT_DIST else [":frontend_dist"]),  # keep
    importpath = "tisane/cmd/tisane",
    visibility = ["//visibility:private"],
    deps = [
        "//cmd/tisane/app",
        "@com_github_wailsapp_wails_v3//pkg/application",
    ],
)

go_binary(
    name = "tisane",
    embed = [":tisane_lib"],
    gc_linkopts = select({
        "@rules_go//go/platform:windows": ["-H=windowsgui"],
        "//conditions:default": [],
    }),  # keep
    visibility = ["//visibility:public"],
)

go_binary(
    name = "tisane_linux_bin",
    out = "tisane",
    embed = [":tisane_lib"],
    goarch = "amd64",
    goos = "linux",
    pure = "on",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

go_binary(
    name = "tisane_windows_bin",
    embed = [":tisane_lib"],
    gc_linkopts = ["-H=windowsgui"],  # keep
    goarch = "amd64",
    goos = "windows",
    pure = "on",
    tags = ["manual"],
    visibility = ["//visibility:private"],
)

genrule(
    name = "tisane-windows",
    srcs = [":tisane_windows_bin"],
    outs = ["tisane.exe"],
    cmd = "cp $< $@",
    cmd_ps = "Copy-Item -LiteralPath '$<' -Destination '$@' -Force",
    executable = True,
    visibility = ["//visibility:public"],
)

go_test(
    name = "tisane_test",
    srcs = ["main_test.go"],
    embed = [":tisane_lib"],
    deps = [
        "//cmd/tisane/app",
        "@com_github_wailsapp_wails_v3//pkg/application",
    ],
)
