load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "vitebuild_lib",
    srcs = ["main.go"],
    importpath = "tisane/cmd/tisane/internal/vitebuild",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "vitebuild",
    embed = [":vitebuild_lib"],
    visibility = ["//cmd/tisane:__subpackages__"],
)

go_test(
    name = "vitebuild_test",
    srcs = ["main_test.go"],
    embed = [":vitebuild_lib"],
)
