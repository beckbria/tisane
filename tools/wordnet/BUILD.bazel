load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "wordnet_lib",
    srcs = [
        "downloader.go",
        "main.go",
        "parser.go",
    ],
    importpath = "tisane/tools/wordnet",
    visibility = ["//visibility:private"],
    deps = [
        "//pkg/tsd",
        "//pkg/wordlist",
    ],
)

# Tagged manual so `bazel build //...` never builds or runs dictionary generators automatically.
go_binary(
    name = "wordnet",
    embed = [":wordnet_lib"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "wordnet_test",
    srcs = ["main_test.go"],
    embed = [":wordnet_lib"],
    deps = ["//pkg/tsd"],
)
